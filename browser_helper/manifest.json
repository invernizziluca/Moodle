{
  "manifest_version": 3,
  "name": "FFHS — Video dal browser",
  "version": "0.4.0",
  "description": "Rileva file video nelle schede Moodle FFHS e li scarica con la sessione del browser.",
  "permissions": ["webRequest", "downloads", "storage", "tabs"],
  "host_permissions": ["https://moodle.ffhs.ch/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Video Moodle FFHS"}
}
